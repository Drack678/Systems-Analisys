# Database (Docker sobreescribe DATABASE_URL y REDIS_URL en compose)
POSTGRES_PASSWORD=umos_pass
DATABASE_URL=postgresql+asyncpg://umos_user:umos_pass@localhost:5432/umos_db
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=change-me-in-production

# ── APIs reales (las únicas que necesitas) ───────────────────────────────────
# OpenWeather → clima en Bogotá, alertas de lluvia, ajuste ACO por lluvia
OPENWEATHER_API_KEY=

# OpenRouteService → geometría de rutas sobre calles reales de Bogotá
# Sin esta key se usa OSRM público (más lento / menos estable)
ORS_API_KEY=

# ── Opcionales (sin key = datos simulados / ArcGIS público de TransMilenio) ─
# IDEAM_API_KEY=    # lluvia oficial Colombia — OpenWeather la cubre
# SDM_API_KEY=      # tráfico distrital — simulado en dev
# IDU_API_KEY=      # obras viales — simulado en dev
# MAPBOX_TOKEN=     # mapa — Leaflet + CARTO no lo requiere

# ACO Tuning (W1/W4 calibration)
ACO_N_ANTS=50
ACO_MAX_ITERATIONS=100
ACO_ALPHA=1.0
ACO_BETA=2.0
ACO_RHO=0.1
ACO_RAIN_MULTIPLIER=1.63
ACO_RAIN_THRESHOLD_MMH=2.0

# Alerts
RAIN_ALERT_THRESHOLD_MMH=2.0
RAIN_LEAD_TIME_MINUTES=10
CONGESTION_THRESHOLD=0.75

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
